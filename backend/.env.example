# Copy to backend/.env and fill in. NEVER commit backend/.env (it is gitignored).
# Verify everything with: python scripts/smoke_test.py

# --- Speech recognition: Deepgram (console.deepgram.com → API Keys) ---
DEEPGRAM_API_KEY=
# The channels raced against each other, comma-separated (D-036). Deepgram's `multi`
# code-switching mode does NOT cover Arabic, so we run one connection per language and pick
# the better transcript per utterance. Narrow this to a single value to debug one channel.
DEEPGRAM_LANGUAGES=ar,en
# Silence (ms) that ends a turn. Deepgram's own default of 10 cuts speakers off mid-thought.
DEEPGRAM_ENDPOINTING_MS=500
# Set to 1 to log every message from both Deepgram channels. Verbose (one line per channel
# per 250ms), and the fastest way to answer "why did the call go deaf".
SPEECH_DEBUG=
# Deepgram's Arabic model returns empty finals for words its interims already showed
# (D-055). The fallback to the best interim is always on. This asks Deepgram to flush as
# well — measured WORSE (it cuts sentences mid-word), so it is off. Kept as a knob.
FINALIZE_ON_LOST_INTERIM=0

# --- Brain: Google Gemini (aistudio.google.com → Get API key) ---
GEMINI_API_KEY=
# Fill these from the model names smoke_test.py prints, e.g. gemini-2.5-flash
GEMINI_MODEL=
GEMINI_TTS_MODEL=
# The background fact extractor (product.md §9) runs once per turn on top of the brain call,
# and its job is filling in a JSON schema — so it goes on the cheapest model that can do
# that, not on the conversational one. Defaults to gemini-3.5-flash-lite if unset.
GEMINI_EXTRACTOR_MODEL=gemini-3.5-flash-lite
# Free TTS quota is per model per day and small (~10 requests, D-038), so list spare
# models here — voice.py walks the chain on a 429 instead of failing the turn.
GEMINI_TTS_MODEL_FALLBACKS=gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts

# --- Voice synthesis ---
# gemini (default, free — use for all development) | elevenlabs (DEMO ONLY) | browser (fallback)
TTS_PROVIDER=gemini
# Gemini prebuilt voice names (the model list is printed by smoke_test.py; the voice list is
# in the speech-generation docs). Chosen by round-trip: synthesised Egyptian Arabic, then
# transcribed back through Deepgram — Sulafat "Warm" 0.993, Achernar "Soft" 0.935.
GEMINI_TTS_VOICE_AR=Sulafat
GEMINI_TTS_VOICE_EN=Achernar

# ElevenLabs (elevenlabs.io → Profile → API key). Free quota ~10k chars/month:
# rationed for the Loom recording and the live demo only.
ELEVENLABS_API_KEY=
# One male + one female per language slot; VOICE_GENDER picks which set is used.
# NOTE: none of these six, nor VOICE_GENDER, has any effect until the ElevenLabs provider is
# built in Phase 6 — the Gemini path picks its voice by name (GEMINI_TTS_VOICE_AR/_EN above),
# and Google publishes no gender for its 30 prebuilt voices, only a character label.
ELEVENLABS_VOICE_AR_EGYPTIAN_MALE=
ELEVENLABS_VOICE_AR_EGYPTIAN_FEMALE=
ELEVENLABS_VOICE_AR_GULF_MALE=
ELEVENLABS_VOICE_AR_GULF_FEMALE=
ELEVENLABS_VOICE_EN_MALE=
ELEVENLABS_VOICE_EN_FEMALE=
# female | male — Sarjy's default voice gender across personas and languages
VOICE_GENDER=

# --- Database: Supabase PostgreSQL (Project → Connect → Session pooler URI) ---
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Deploy (Phase 3) ---
# Browser origins allowed to call the API and open /ws. Comma-separated; localhost:5173 is
# always allowed on top of whatever is listed here. An entry may start with `*.` to match a
# domain suffix — Vercel gives every preview build its own hostname, so keep `*.vercel.app`.
# Example: ALLOWED_ORIGINS=https://sarjy.vercel.app,*.vercel.app
ALLOWED_ORIGINS=

# --- Barge-in (Phase 4, product.md §11) ---
# The microphone stays open while Sarjy speaks, so these two numbers are what separate "a
# person started talking" from "the speaker is bleeding into the microphone". Raise the
# confidence floor first if Sarjy ever interrupts itself.
BARGE_IN_MIN_WORDS=2
BARGE_IN_MIN_CONFIDENCE=0.30

# --- Demonstrating the designed states (Phase 5) ---
# Makes the next turn fail on purpose, at exactly the point the real failure happens, so the
# bilingual rate-limit screens can be seen and re-verified without waiting a day for a quota
# or spending one. One of:
#   brain_quota   the day's Gemini allowance is spent — honest "not today", no retry
#   brain_busy    a per-minute burst limit — friendly notice, countdown, automatic retry
#   brain         the brain failed — friendly notice, countdown, automatic retry
#   voice_quota   TTS is out — the reply is read by the browser's own voice instead
#   voice         synthesis failed — same browser-voice fallback
# ALWAYS EMPTY in .env.cloudrun.yaml. It can only make Sarjy worse, never let it do more.
FAULT_INJECT=

# --- Defaults ---
DEFAULT_CITY=Alexandria
# Only used when the geocoder cannot be reached at all. Without it a network blip would
# silently move the user to UTC, and "بكرة" would resolve to the wrong day near midnight.
DEFAULT_TIMEZONE=Africa/Cairo
